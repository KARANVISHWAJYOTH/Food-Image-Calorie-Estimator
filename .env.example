# NutriVision AI Environment Configuration

# Backend JWT Authentication Secret Key
# Change this to a secure random string (e.g. openssl rand -hex 32) in production
SECRET_KEY=nutrivision_super_secret_jwt_key_2026_change_in_prod

# Model Inference Variant: fp32 | int8
MODEL_VARIANT=fp32

# SQLite Data Directory (optional override)
# DATA_DIR=./backend/data

# Frontend API URL
VITE_API_URL=http://localhost:8000
