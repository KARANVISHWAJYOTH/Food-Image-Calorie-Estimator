# NutriVision AI Environment Configuration
# Copy this file to .env and fill in the required values.

# Backend storage (optional; defaults to backend/data and backend/data/uploads)
# Relative paths are resolved from the process working directory, so prefer
# absolute paths or the defaults.
# DATABASE_URL=postgresql://nutri_user:nutri_pass@localhost:5432/nutrivision
# DATA_DIR=./backend/data
# UPLOADS_DIR=./backend/data/uploads

# Backend JWT Authentication Secret Key
# REQUIRED when APP_ENV=production; the app refuses to start without it.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# development | production
APP_ENV=development

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Create the demo account (demo_user / demo@nutrivision.ai) on startup.
# Set to false for production deployments.
SEED_DEMO=true

# Model Inference Variant: fp32 | int8
MODEL_VARIANT=fp32

# Frontend API URL. Leave empty for same-origin requests (Vite dev proxy or
# nginx reverse proxy). Set it only when the API lives on another origin.
VITE_API_URL=
